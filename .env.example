# Canonical public origin (no trailing slash). Required for metadata/OG; set in Vercel for each environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Simulated delay for the resume rewrite loading state (milliseconds).
NEXT_PUBLIC_MOCK_REWRITE_DELAY_MS=2200
# Optional: mock API failure rate for the rewrite demo only (0–1). Example: 0.25 = ~25% failures to exercise error UI.
# NEXT_PUBLIC_MOCK_REWRITE_FAIL_RATE=0
